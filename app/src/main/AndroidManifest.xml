<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <!-- Email clients for sending invoices -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InvoiceApp"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ResetPasswordActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="invoiceapp"
                    android:host="reset-password" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Invoice Activities -->
        <activity
            android:name=".activities.CreateInvoiceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.InvoiceDetailActivity"
            android:exported="false" />

        <!-- Recurring Invoices Activity -->
        <activity
            android:name=".activities.CreateRecurringTemplateActivity"
            android:exported="false"
            android:label="Recurring Invoice Template"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Quotation Activity -->
        <activity
            android:name=".activities.CreateQuotationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Customer Activities -->
        <activity
            android:name=".activities.CustomersActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AddEditCustomerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.CustomerCommunicationThreadActivity"
            android:exported="false"
            android:label="Customer Communication"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Expense Activities -->
        <activity
            android:name=".activities.ExpensesActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AddEditExpenseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Settings -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false" />

        <!-- Manage Items -->
        <activity
            android:name=".activities.ManageItemsActivity"
            android:exported="false"
            android:label="Manage Items"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Communication -->
        <activity
            android:name=".activities.CommunicationActivity"
            android:exported="false"
            android:label="Communication"
            android:parentActivityName=".activities.InvoiceDetailActivity" />

        <!-- Pending Follow Ups -->
        <activity
            android:name=".activities.PendingFollowUpsActivity"
            android:exported="false"
            android:label="Pending Follow-ups"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Email Verification -->
        <activity
            android:name=".activities.VerifyEmailActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http"
                    android:host="*"
                    android:pathPattern="/verify-email-page" />
                <data android:scheme="https"
                    android:host="*"
                    android:pathPattern="/verify-email-page" />
                <data android:scheme="invoiceapp"
                    android:host="verify" />
            </intent-filter>
        </activity>

        <!-- File Provider for PDF sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".activities.ThemeSettingsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.TemplateSettingsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

    </application>

</manifest>
